# Cloudflare static asset headers (copied into dist/ by Vite)

# Vite's build files have a content hash in their name, so they never change: cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep the same name when replaced, so cache them for a day, then quietly re-check
/badges/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/avatar.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
